<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Built by TargetsTests rather than by the solution, which is why it is absent from
    IntegrationTests.slnx: it deliberately contains a misconfigured template so the build-time
    check has something to catch, and a project that warns on every solution build would be noise.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TargetsFixture</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Parchment" />
  </ItemGroup>

  <ItemGroup>
    <!-- Declared through the item type the package ships; expands to AdditionalFiles. Discovery
         would have found it anyway, so this covers the declared path staying a no-op rather than
         a second, duplicate entry. -->
    <ParchmentTemplate Include="Templates\CopiedModel.parchment.md" />
    <!-- The shape PARCH100 exists to catch: one file, two item types. -->
    <AdditionalFiles Include="Templates\DualModel.parchment.md" />
    <EmbeddedResource Include="Templates\DualModel.parchment.md" />
  </ItemGroup>

  <!-- DiscoveredModel.parchment.md carries no entry at all: the package's globs are the only thing
       that can put it in front of the generator. -->

</Project>
