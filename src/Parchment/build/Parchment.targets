<Project>

  <!--
    The late half of template authoring. Parchment.props, imported ahead of the project body, globs
    the templates into ParchmentTemplate; this file, imported after it, hands them to the source
    generator through AdditionalFiles — the only channel Roslyn gives a generator. Being last is
    what lets it see everything the project declared, removed, or updated.

    <ParchmentTemplate Include="..\Shared\Invoice.parchment.docx" />

    declares a template the globs cannot reach — one outside the project folder, or under a path
    the default excludes cover. It maps to AdditionalFiles and nothing else, so an IDE that models
    one build action per file keeps the file visible to the generator. The name still carries the
    marker: declaring a file says where it is, not what it binds to.
  -->
  <ItemGroup>
    <_ParchmentDiscovered Include="@(ParchmentTemplate->WithMetadataValue('ParchmentDiscovered', 'true'))" />
    <_ParchmentDeclared Include="@(ParchmentTemplate->WithMetadataValue('ParchmentDiscovered', 'false'))" />
    <AdditionalFiles Include="@(_ParchmentDeclared)" />
    <!-- A discovered template the project also declares by hand reaches the generator once, under
         the declared spelling. The glob cannot make that exclusion itself: it runs before the
         project body, when nothing has been declared yet. -->
    <AdditionalFiles Include="@(_ParchmentDiscovered)"
                     Exclude="@(_ParchmentDeclared);@(AdditionalFiles)" />
  </ItemGroup>

  <!--
    Warns when a template carries a second item type, which is the shape that produces a PARCH004
    only an IDE can see. Detected here rather than left to the generator because the generator
    cannot see it: by the time the file has been resolved to its other identity there is nothing in
    AdditionalFiles to report on, and a command-line build never reproduces it.

    Scoped to template extensions, since another analyzer's additional files are none of Parchment's
    business. And scoped to EmbeddedResource and Content: the None item the SDK's default glob gives
    every template is deliberately not counted — None is never handed to the compiler, so it cannot
    hide the file from the generator, and it is what keeps a template listed in a solution explorer.
  -->
  <Target Name="ParchmentWarnOnDualItemTypes"
          BeforeTargets="CoreCompile"
          Condition="'@(AdditionalFiles)' != ''">
    <ItemGroup>
      <_ParchmentTemplateLike Include="@(AdditionalFiles->'%(FullPath)')"
                              Condition="'%(Extension)' == '.md' or '%(Extension)' == '.docx' or '%(Extension)' == '.dotx'" />
      <_ParchmentOtherIdentity Include="@(EmbeddedResource->'%(FullPath)');@(Content->'%(FullPath)')" />
      <!-- Intersection, the MSBuild way: the candidates, less those that are only candidates. -->
      <_ParchmentSingleIdentity Include="@(_ParchmentTemplateLike)" Exclude="@(_ParchmentOtherIdentity)" />
      <_ParchmentDualIdentity Include="@(_ParchmentTemplateLike)" Exclude="@(_ParchmentSingleIdentity)" />
    </ItemGroup>

    <Warning Condition="'@(_ParchmentDualIdentity)' != ''"
             Code="PARCH100"
             File="$(MSBuildProjectFullPath)"
             Text="Template %(_ParchmentDualIdentity.Filename)%(_ParchmentDualIdentity.Extension) is an AdditionalFile and also an EmbeddedResource or Content item. This build is unaffected, but an IDE that models one build action per file can resolve it to the other identity, hide it from the source generator, and report PARCH004 against a csproj entry that is present. Templates are embedded into the generated source, so the second item type is also unnecessary — declare the file with &lt;ParchmentTemplate&gt; only." />
  </Target>

</Project>
